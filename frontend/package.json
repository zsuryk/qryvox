{
  "name": "@qryvox/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "tsx --conditions=source scripts/pdfjs-assets.ts",
    "dev": "pnpm run assets && pnpm --filter @qryvox/shared build && next dev",
    "build": "pnpm run assets && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@qryvox/shared": "workspace:*",
    "next": "catalog:",
    "pdfjs-dist": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
