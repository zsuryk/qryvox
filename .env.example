# Copy to .env at the repository root for local development. Production values live only in the
# Vercel projects, managed by the owner (ADR-0001).

# Database: a local file in dev, libsql:// + auth token (Turso) in production.
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=

# Backend CORS allow-list: the frontend origin.
ALLOWED_ORIGIN=http://localhost:3000

# Frontend: where the backend lives.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Model: any OpenAI-compatible chat-completions endpoint. Unset = new analysis steps answer 503.
#   Ollama (local)    LLM_BASE_URL=http://localhost:11434/v1   no key
#   LM Studio (local) LLM_BASE_URL=http://localhost:1234/v1    no key
#   OpenAI            LLM_BASE_URL=https://api.openai.com/v1
#   Anthropic         LLM_BASE_URL=https://api.anthropic.com/v1/
#   Gemini            LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter        LLM_BASE_URL=https://openrouter.ai/api/v1
# A deployed backend cannot reach a model on your machine; local models are for local development.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Default 0. Set to none for models that reject a temperature.
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=240000
