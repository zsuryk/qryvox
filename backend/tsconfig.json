{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The fetch Response in llm.ts needs the DOM lib; without it the deploy log reports bogus errors
    // because Vercel type-checks with this tsconfig (ADR-0001).
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src", "api", "test", "scripts", "drizzle.config.ts"]
}
