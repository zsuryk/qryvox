{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --filter @qryvox/backend...",
  "buildCommand": "pnpm --filter @qryvox/shared build && mkdir -p static && printf 'User-agent: *\\nDisallow: /\\n' > static/robots.txt",
  "outputDirectory": "static",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
