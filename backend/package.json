{
  "name": "@qryvox/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../.env src/server.ts",
    "api:docs": "tsx --conditions=source --env-file-if-exists=../.env scripts/docs-server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=source --env-file-if-exists=../.env scripts/db.ts migrate",
    "db:check": "tsx --conditions=source --env-file-if-exists=../.env scripts/db.ts check",
    "record:fixture": "tsx --conditions=source scripts/record-fold-fixture.ts",
    "smoke": "tsx --conditions=source scripts/smoke.ts",
    "seed:demo": "tsx --conditions=source scripts/demo-seed.ts",
    "e2e": "tsx --conditions=source scripts/e2e.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@libsql/client": "catalog:",
    "@qryvox/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "playwright-core": "^1.63.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
